# Copy to .env for local runs (`make dev`). Never commit .env: git, Docker and gcloud all
# ignore it. On Cloud Run both secrets come from Secret Manager instead (see README.md).
# Quote a value that holds spaces, for example CLASS_PASSWORD="three random words".

# The pre-shared password every student enters on the login page.
CLASS_PASSWORD=
# A random string of at least 32 characters that signs session cookies. The server refuses to
# start with a shorter one. Make one with: openssl rand -base64 48
SESSION_SECRET=
# The port the server listens on. Cloud Run sets its own.
PORT=8080
